{
  "name": "mawjod-sdk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --recursive --filter \"./packages/*\" run build",
    "typecheck": "pnpm --recursive --filter \"./packages/*\" run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:build": "pnpm --filter @mawjod/docs run docs:build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
