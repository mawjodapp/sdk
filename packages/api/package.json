{
  "name": "@mawjod/api",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript client for the Mawjod storefront API.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mawjodapp/sdk.git",
    "directory": "packages/api"
  },
  "homepage": "https://mawjodapp.github.io/sdk/",
  "bugs": "https://github.com/mawjodapp/sdk/issues",
  "keywords": ["mawjod", "storefront", "ecommerce", "api-client", "typescript"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
